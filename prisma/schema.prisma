// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 配对 —— 一对姐姐+妹妹的陪伴关系，多对隔离的根
model Pair {
  id        String   @id @default(cuid())
  /// 6 位配对码，妹妹注册时输入以关联姐姐
  code      String   @unique
  /// 创建者（姐姐）账号 id，便于展示
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 账号 —— 姐姐或妹妹，用户名+密钥登录
model Account {
  id           String   @id @default(cuid())
  /// 登录用户名（唯一）
  username     String   @unique
  /// bcrypt 哈希后的密钥
  passwordHash String
  /// 显示名（"姐姐"/"妹妹"或自定义昵称）
  displayName  String
  /// 角色：sister 姐姐 / younger 妹妹
  role         String
  /// 所属配对 id（姐姐注册时创建 Pair，妹妹注册时关联到姐姐的 Pair）
  pairId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// 首页小岛留言 —— 姐姐和妹妹可自由编辑的共享语录，标注作者视角
/// 多对隔离：每对 pair 一条，按 pairId 唯一
model HomeQuote {
  id         String   @id @default(cuid())
  content    String
  /// 作者角色：sister 姐姐 / younger 妹妹
  authorRole String
  /// 所属配对 id —— 每对 pair 一条留言，@unique 便于 upsert
  pairId     String   @unique
  updatedAt  DateTime @updatedAt
}

/// 首页顶部问候（大标题 + 副标题）—— 姐姐视角下可自由编辑，两人共享
/// 多对隔离：每对 pair 一条，按 pairId 唯一
model HomeGreeting {
  id         String   @id @default(cuid())
  heading    String
  subtitle   String
  /// 作者角色：sister 姐姐 / younger 妹妹（当前仅姐姐视角可编辑）
  authorRole String
  /// 所属配对 id —— 每对 pair 一条问候，@unique 便于 upsert
  pairId     String   @unique
  updatedAt  DateTime @updatedAt
}

/// 错题记录 —— 妹妹拍下做错的题，姐姐可以看到并留言鼓励
model MistakeRecord {
  id        String   @id @default(cuid())
  type      String
  filePath  String
  mimeType  String
  duration  Int?
  note      String?
  subject   String?
  createdBy String
  pairId    String
  createdAt DateTime @default(now())
}

/// 实时聊天消息 —— 姐姐和妹妹之间的陪伴对话
model ChatMessage {
  id         String   @id @default(cuid())
  senderRole String
  type       String
  content    String?
  filePath   String?
  duration   Int?
  pairId     String
  createdAt  DateTime @default(now())
}

/// 今日任务 —— 姐姐和妹妹都可创建，体现"自主规划"而非"被派活"
model Task {
  id                 String    @id @default(cuid())
  title              String
  subject            String?
  estimatedPomodoros Int       @default(1)
  completedPomodoros Int       @default(0)
  done               Boolean   @default(false)
  completedAt        DateTime?
  createdBy          String
  taskDate           String
  pairId             String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// 专注/休息会话记录 —— 番茄钟每次完成一段就记一条
model FocusSession {
  id             String   @id @default(cuid())
  role           String
  taskId         String?
  durationMinutes Int
  type           String
  pairId         String
  completedAt    DateTime @default(now())
}

/// 心情记录 —— 妹妹/姐姐记录当天心情，体现陪伴而非监督
model MoodEntry {
  id        String   @id @default(cuid())
  role      String
  mood      String
  note      String?
  pairId    String
  createdAt DateTime @default(now())
}

/// 每日留言 —— 姐姐和妹妹给彼此留的小纸条（慢沟通，区别于实时聊天）
model DailyNote {
  id         String   @id @default(cuid())
  authorRole String
  content    String
  noteDate   String
  pairId     String
  createdAt  DateTime @default(now())
}
